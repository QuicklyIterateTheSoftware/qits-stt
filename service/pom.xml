<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-stt</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The stt SERVICE layer: the one JAX-RS route (POST /speech/transcriptions) and the mapper
         that turns this context's framework-free DomainExceptions into HTTP responses. Everything
         that needs a web stack, and therefore cannot live in `domain`.

         A DEPLOYABLE APP, not a library JAR. It was extracted as a library — "a consuming Quarkus
         application pulls it in and gets the route" — because packaging it would have needed an
         auth variant and a main class. Both reasons have lapsed: authentication terminates at
         qits-gateway and this module reads a header (see security/), and Quarkus supplies the main
         class. What remained was a route no process could serve.

         See migration-deployables-plan.md in the superproject. -->
    <artifactId>qits-stt-service</artifactId>
    <name>qits-stt :: service</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-stt-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- SecurityIdentity + the HttpAuthenticationMechanism SPI, for the single thing this
                 service does about auth: read qits-gateway's X-Qits-User header into an identity
                 (see security/ForwardAuthMechanism). NOT an auth variant and NOT an authorization
                 policy — the monolith's -Dqits.variant auth/* modules do not come here at all;
                 authentication terminates at the gateway (migration-auth-plan.md). -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- @Valid / @NotBlank on the request record. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <!-- The API document at /q/openapi and the browsable UI at /q/swagger-ui. The other
                 five extracted services carried this out of the monorepo; stt did not, so it was
                 the one service that could not describe its own surface. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- This module is the DEPLOYABLE, not a library jar. Augmentation is what produces
                     target/quarkus-app/quarkus-run.jar; without this execution `mvn verify` proves
                     the tests pass and proves nothing about whether the thing starts. Version comes
                     from the root pom's pluginManagement. -->
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
